{
    "format_version": "1.21.50",
    "minecraft:block": {
        "description": {
            "identifier": "subo:rift_transporter",
            "menu_category": {
                "category": "equipment"
            },
            "states": {
                "subo:state": [
                    "inactive",
                    "active",
                    "broken"
                ]
            }
        },
        "components": {
            "subo:rift_transporter": {},
			"minecraft:loot": "loot_tables/empty.json",
            "minecraft:geometry": "geometry.rift_transporter",
            "minecraft:collision_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    2,
                    16
                ]
            },
            "minecraft:selection_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    2,
                    16
                ]
            },
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 2.0
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 3.0
            },
            "minecraft:light_dampening": 0,
            "minecraft:map_color": "#5A2A8A"
        },
        "permutations": [
            {
                "condition": "q.block_state('subo:state') == 'inactive'",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "rift_transporter_inactive",
                            "render_method": "alpha_test"
                        }
                    }
                }
            },
            {
                "condition": "q.block_state('subo:state') == 'active'",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "rift_transporter_active",
                            "render_method": "alpha_test"
                        }
                    },
                    "minecraft:light_emission": 7
                }
            },
            {
                "condition": "q.block_state('subo:state') == 'broken'",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "rift_transporter_broken",
                            "render_method": "alpha_test"
                        }
                    }
                }
            }
        ]
    }
}