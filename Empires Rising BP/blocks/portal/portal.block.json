{
  "format_version": "1.21.100",
  "minecraft:block": {
    "description": {
      "identifier": "subo:portal",
      "menu_category": {
        "category": "construction"
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"]
        }
      },
      "states": {
        "subo:half": ["lower", "upper"],
        "subo:active": [false, true]
      }
    },
    "components": {
      "minecraft:loot": "loot_tables/empty.json",
      "subo:portal_block": {},
      "minecraft:geometry": "geometry.subo_portal_lower",
      "minecraft:material_instances": {
        "*": {
          "texture": "subo_portal",
          "render_method": "alpha_test"
        }
      },
      "minecraft:collision_box": {
        "origin": [-8, 0, -1],
        "size": [16, 16, 2]
      },
      "minecraft:selection_box": {
        "origin": [-8, 0, -1.5],
        "size": [16, 16, 3]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 2
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 6
      },
      "minecraft:light_dampening": 0
    },
    "permutations": [
      {
        "condition": "q.block_state('subo:half') == 'upper'",
        "components": {
          "minecraft:geometry": "geometry.subo_portal_upper",
          "minecraft:collision_box": {
            "origin": [-8, 0, -1],
            "size": [16, 16, 3]
          },
          "minecraft:selection_box": {
            "origin": [-8, 0, -1.5],
            "size": [16, 15, 3]
          }
        }
      },

      {
        "condition": "q.block_state('subo:active') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "subo_portal_active",
              "render_method": "alpha_test",
              "ambient_occlusion": false
            }
          },
          "minecraft:light_emission": 8
        }
      },

      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 0, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 180, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 90, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 270, 0] }
        }
      }
    ]
  }
}