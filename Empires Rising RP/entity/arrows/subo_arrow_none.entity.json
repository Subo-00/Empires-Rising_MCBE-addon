{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "subo:arrow_none",
      "materials": {
        "default": "arrow"
      },
      "textures": {
        "default": "textures/entity/arrow"
      },
      "geometry": {
        "default": "geometry.arrow"
      },
      "animations": {
        "move": "animation.subo.arrow.move",
        "trail": "animation.subo.arrow.trail"
      },
      "scripts": {
        "pre_animation": [
          "variable.shake = query.shake_time - query.frame_alpha;",
          "variable.shake_power = variable.shake > 0.0 ? -Math.sin(variable.shake * 200.0) * variable.shake : 0.0;"
        ],
        "animate": [
          "move",
          "trail"
        ]
      },
      "render_controllers": ["controller.render.arrow"],
      "particle_effects": {
        "trail": "minecraft:evocation_fang_particle"
      }
    }
  }
}