{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.fire_spirit.main": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "animations": ["idle"],
                    "transitions": [
                        { "walk": "query.modified_move_speed > 0.1" }
                    ]
                },
                "walk": {
                    "animations": ["walk"],
                    "transitions": [
                        { "idle": "query.modified_move_speed <= 0.1" }
                    ]
                }
            }
        },
        "controller.animation.fire_spirit.leap": {
            "initial_state": "none",
            "states": {
                "none": {
                    "transitions": [
                        { "leaping": "query.property('subo:is_leaping') == true" }
                    ]
                },
                "leaping": {
                    "animations": ["leap"],
                    "transitions": [
                        { "none": "query.property('subo:is_leaping') == false" }
                    ]
                }
            }
        }
    }
}